{
  "font": {
    "family": {
      "display": {
        "$value": "\"Brygada 1918\", Georgia, serif",
        "$type": "fontFamily",
        "$description": "display: Brygada 1918 (romana de contraste baixo, inscrição). Não é da lista do cemitério."
      },
      "text": {
        "$value": "\"Figtree\", system-ui, sans-serif",
        "$type": "fontFamily",
        "$description": "texto e UI: Figtree (humanista contemporâneo)."
      }
    },
    "size": {
      "display": {
        "$value": "clamp(2.5rem, 1.6rem + 4vw, 4.75rem)",
        "$type": "string",
        "$description": "display, até 76px"
      },
      "h1": {
        "$value": "clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem)",
        "$type": "string",
        "$description": "h1"
      },
      "h2": {
        "$value": "1.375rem",
        "$type": "string",
        "$description": "h2"
      },
      "body": {
        "$value": "1rem",
        "$type": "string",
        "$description": "corpo"
      },
      "small": {
        "$value": "0.875rem",
        "$type": "string",
        "$description": "texto de apoio"
      },
      "label": {
        "$value": "0.75rem",
        "$type": "string",
        "$description": "label caixa-alta"
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$type": "string",
        "$description": ""
      },
      "medium": {
        "$value": "500",
        "$type": "string",
        "$description": ""
      },
      "semibold": {
        "$value": "600",
        "$type": "string",
        "$description": ""
      }
    }
  },
  "line-height": {
    "tight": {
      "$value": "1.05",
      "$type": "string",
      "$description": "display"
    },
    "heading": {
      "$value": "1.2",
      "$type": "string",
      "$description": "títulos"
    },
    "body": {
      "$value": "1.55",
      "$type": "string",
      "$description": "corpo"
    }
  },
  "letter-spacing": {
    "label": {
      "$value": "0.12em",
      "$type": "string",
      "$description": "caixa-alta de label"
    }
  }
}
